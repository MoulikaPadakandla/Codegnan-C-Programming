#include<stdio.h>
void main(){
    int a[7]={1,2,3,4,1,3,2},i,j;
    int unique[7],temp=0;
    for(i=0;i<7;i++){
        int count = 0;
        for(j=0;j<temp;j++){
            if(a[i]==unique[j]){
                count++;
                break;
            }
        }
        if(count==0){
        unique[temp]=a[i];
        temp++;
        }
    }
    printf("Array after getting the unique data: ");
    for(i=0;i<temp;i++){
        printf("%d ",unique[i]);
    }
}
