#include<stdio.h>
void main(){
    int a[2][2]={1,2,3,4},b[2][2]={4,3,2,1},c[2][2],i,j;
    for(i=0;i<2;i++){
        for(j=0;j<2;j++){
            c[i][j]=a[i][j]+b[i][j];
        }
    }
    printf("sum of 2 matrices are: \n");
    for(i=0;i<2;i++){
        for(j=0;j<2;j++){
            printf("%d ", c[i][j]);
        }
        printf("\n");
    }
}
